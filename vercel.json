{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/:file(.+\\.(?:png|jpg|jpeg|gif|svg|webp|ico|avif))",
      "destination": "/public/:file"
    }
  ]
}
